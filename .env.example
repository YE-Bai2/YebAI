# Copy to .env.local for local development.
# Never commit real API keys or secrets.
# Official OpenAI API (preferred when configured)
OPENAI_API_KEY=
# Optional model override; defaults to gpt-4o-mini
OPENAI_MODEL=
# Optional fallback provider: OpenRouter (used only when OPENAI_API_KEY is absent)
OPENROUTER_API_KEY=
# Optional model override; defaults to openrouter/auto
OPENROUTER_MODEL=
# fal.ai image and video generation
FAL_KEY=
# Optional: URL displayed to OpenRouter for request attribution
# APP_URL=https://yeb-ai-qsk2.vercel.app
# DATABASE_URL=
# STORAGE_BUCKET=
# STORAGE_REGION=
